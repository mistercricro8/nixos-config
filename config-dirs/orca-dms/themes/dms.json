{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#131316",
    "--editor-surface": "#131316",
    "--card": "#201f23",
    "--popover": "#2a292d",
    "--primary": "#c0c2f9",
    "--secondary": "#c5c4dc",
    "--muted": "#201f23",
    "--accent": "#353438",
    "--border": "#46464f",
    "--input": "#46464f",
    "--sidebar": "#1b1b1f",
    "--sidebar-border": "#46464f",
    "--foreground": "#e5e1e6",
    "--popover-foreground": "#e5e1e6",
    "--primary-foreground": "#292c59",
    "--secondary-foreground": "#2e2f42",
    "--muted-foreground": "#c7c5d0",
    "--accent-foreground": "#e5e1e6",
    "--ring": "#c0c2f9",
    "--sidebar-foreground": "#e5e1e6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#918f9a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c0c2f9"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f0b5de"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#c5c4dc"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#e0e0ff"
      }
    },
    {
      "scope": [
        "variable",
        "entity.name.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e5e1e6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e1e0f9"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#c0c2f9"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#ffd7f1"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffb4ab"
      }
    }
  ]
}
