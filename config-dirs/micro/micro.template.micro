color-link default "{{colors.on_surface.default.hex}}"
color-link comment "{{colors.on_surface_variant.default.hex}}"
color-link selection "{{colors.on_surface.default.hex}},{{colors.surface_container_high.default.hex}}"
color-link hlsearch "{{colors.secondary.default.hex}}"

color-link identifier "{{colors.primary.default.hex}}"
color-link identifier.class "{{colors.primary.default.hex}}"
color-link identifier.var "{{colors.primary.default.hex}}"

color-link constant "{{colors.secondary.default.hex}}"
color-link constant.number "{{colors.secondary.default.hex}}"
color-link constant.string "{{colors.tertiary.default.hex}}"

color-link symbol "{{colors.secondary_fixed.default.hex}}"
color-link symbol.brackets "{{colors.secondary_fixed_dim.default.hex}}"
color-link symbol.tag "{{colors.primary.default.hex}}"

color-link type "{{colors.primary.default.hex}}"
color-link type.keyword "{{colors.tertiary.default.hex}}"

color-link special "{{colors.secondary_fixed.default.hex}}"
color-link statement "{{colors.primary.default.hex}}"
color-link preproc "{{colors.secondary_fixed.default.hex}}"

color-link underlined "{{colors.primary_fixed.default.hex}}"
color-link error "bold {{colors.secondary_fixed.default.hex}}"
color-link todo "bold {{colors.tertiary.default.hex}}"

color-link diff-added "{{colors.tertiary.default.hex}}"
color-link diff-modified "{{colors.tertiary.default.hex}}"
color-link diff-deleted "{{colors.secondary_fixed.default.hex}}"

color-link gutter-error "{{colors.secondary_fixed.default.hex}}"
color-link gutter-warning "{{colors.tertiary.default.hex}}"

color-link scrollbar "{{colors.on_surface_variant.default.hex}}"
color-link statusline "{{colors.on_surface.default.hex}},{{colors.surface_dim.default.hex}}"
color-link tabbar "{{colors.on_surface.default.hex}},{{colors.surface_dim.default.hex}}"
color-link indent-char "{{colors.surface_container_high.default.hex}}"
color-link line-number "{{colors.outline.default.hex}}"
color-link current-line-number "{{colors.primary.default.hex}}"

color-link cursor-line "{{colors.surface_container.default.hex}},{{colors.on_surface.default.hex}}"
color-link color-column "{{colors.surface_container.default.hex}}"
color-link type.extended "default"
